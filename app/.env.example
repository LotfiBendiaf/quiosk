# Copy to .env.local at the repository root. Never commit secrets.
# DATABASE_URL: Neon pooled PostgreSQL connection URL used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"
# DIRECT_URL: Neon direct connection URL used for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require"
BETTER_AUTH_SECRET="REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3000"
